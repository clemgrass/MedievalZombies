{
    "version": 6,
    "cmakeMinimumRequired": {
        "major": 3,
        "minor": 29,
        "patch": 0
    },
    "configurePresets": [
        {
            "name": "base",
            "hidden": true,
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/build/${presetName}",
            "cacheVariables": {
                "CMAKE_C_COMPILER": "clang",
                "CMAKE_CXX_COMPILER": "clang++",
                "CMAKE_LINKER_TYPE": "LLD",
                "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
            }
        },
        {
            "name": "debug",
            "displayName": "Debug",
            "inherits": "base",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "MZ_SANITIZE": "ON"
            }
        },
        {
            "name": "debug-gcc",
            "displayName": "Debug con GCC (el compilador secundario)",
            "inherits": "debug",
            "cacheVariables": {
                "CMAKE_C_COMPILER": "gcc",
                "CMAKE_CXX_COMPILER": "g++"
            }
        },
        {
            "name": "coverage",
            "displayName": "Coverage (cobertura con llvm-cov, sin sanitizers)",
            "inherits": "base",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "MZ_COVERAGE": "ON"
            }
        },
        {
            "name": "relwithdebinfo",
            "displayName": "RelWithDebInfo (para perfilar)",
            "inherits": "base",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "RelWithDebInfo",
                "CMAKE_C_FLAGS": "-fno-omit-frame-pointer",
                "CMAKE_CXX_FLAGS": "-fno-omit-frame-pointer"
            }
        },
        {
            "name": "release",
            "displayName": "Release",
            "inherits": "base",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release"
            }
        }
    ],
    "buildPresets": [
        { "name": "debug", "configurePreset": "debug" },
        { "name": "debug-gcc", "configurePreset": "debug-gcc" },
        { "name": "coverage", "configurePreset": "coverage" },
        { "name": "coverage-report", "configurePreset": "coverage", "targets": ["coverage"] },
        { "name": "relwithdebinfo", "configurePreset": "relwithdebinfo" },
        { "name": "release", "configurePreset": "release" }
    ],
    "testPresets": [
        {
            "name": "base",
            "hidden": true,
            "output": { "outputOnFailure": true },
            "execution": { "noTestsAction": "error" }
        },
        { "name": "debug", "inherits": "base", "configurePreset": "debug" },
        { "name": "debug-gcc", "inherits": "base", "configurePreset": "debug-gcc" },
        { "name": "relwithdebinfo", "inherits": "base", "configurePreset": "relwithdebinfo" },
        { "name": "release", "inherits": "base", "configurePreset": "release" }
    ],
    "workflowPresets": [
        {
            "name": "debug",
            "displayName": "Debug con Clang: configurar, compilar y probar",
            "steps": [
                { "type": "configure", "name": "debug" },
                { "type": "build", "name": "debug" },
                { "type": "test", "name": "debug" }
            ]
        },
        {
            "name": "debug-gcc",
            "displayName": "Debug con GCC: configurar, compilar y probar",
            "steps": [
                { "type": "configure", "name": "debug-gcc" },
                { "type": "build", "name": "debug-gcc" },
                { "type": "test", "name": "debug-gcc" }
            ]
        },
        {
            "name": "coverage",
            "displayName": "Coverage: configurar, compilar y medir, con la meta del 100 %",
            "steps": [
                { "type": "configure", "name": "coverage" },
                { "type": "build", "name": "coverage" },
                { "type": "build", "name": "coverage-report" }
            ]
        },
        {
            "name": "relwithdebinfo",
            "displayName": "RelWithDebInfo: configurar y compilar",
            "steps": [
                { "type": "configure", "name": "relwithdebinfo" },
                { "type": "build", "name": "relwithdebinfo" }
            ]
        },
        {
            "name": "release",
            "displayName": "Release: configurar y compilar",
            "steps": [
                { "type": "configure", "name": "release" },
                { "type": "build", "name": "release" }
            ]
        }
    ]
}
