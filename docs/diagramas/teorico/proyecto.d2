# Diagrama teórico del proyecto: lo que eligió cada ADR aceptado y cómo se conectan
# las piezas. Es teórico: muestra lo decidido, no el código. Del ADR-0030 solo le toca
# el verificador (b), que el SVG coincida con este .d2 regenerado. Ver el README.md.
#
# Forma: a la izquierda, el mapa del engine y del juego, que ELK ordena según el flujo
# de los datos (del input a la pantalla); el color de cada pieza dice su capa
# (ADR-0012). A la derecha, la franja de proceso.
...@leyenda

grid-columns: 2
horizontal-gap: 80

title: |md
  # MedievalZombies: el proyecto según sus ADRs

  Diagrama **teórico**: muestra lo decidido en los ADRs aceptados, no el código.

  Del ADR-0030 solo le toca el verificador (b): que el SVG coincida con su .d2.
| {near: top-center; width: 900}

vars: {
  # D2 0.9.0 le pone el título "Legend" a esta leyenda y no deja cambiarlo.
  d2-legend: {
    juego: "Juego · game/" {class: juego}
    sistema: "Sistema · engine/" {class: sistema}
    gpu: "GPU · engine/gpu" {class: gpu}
    nucleo: "Núcleo · engine/core" {class: nucleo}
    plataforma: "Plataforma · engine/platform" {class: plataforma}
    herramienta: "Herramienta del build · tools/" {class: herramienta}
    proceso: "Decisión de proceso" {class: proceso}
    a: "" {class: externo; width: 40; height: 24}
    b: "" {class: externo; width: 40; height: 24}
    c: "" {class: externo; width: 40; height: 24}
    a -> b: "le entrega datos a" {class: entrega}
    b -> c: "esta decisión empujó a esa" {class: empuja}
  }
}

# ── El engine y el juego ─────────────────────────────────────────────────────

mapa: "" {
  style: {fill: transparent; stroke: transparent}
  direction: right

  # Fuera del engine
  dispositivos: "Teclado, mouse\ny control" {class: externo}
  pantalla: "Pantalla\ny parlantes" {class: externo}
  cocinador: "Cocinador de assets · ADR-0017\nBlender → glTF → binario cocinado en el build" {class: herramienta}

  # Juego · game/
  combate: "Combate y desmembramiento · ADR-0018\nfuerza por área con umbral,\nespada clavada, plano por el pecho" {class: juego}
  niveles: "Niveles · ADR-0027\nBlender como editor, mundo continuo por zonas,\nfases en texto, culling hasta la niebla" {class: juego}
  cinematicas: "Cinemáticas · ADR-0034\nen el engine, armadas en Blender,\nel mundo se detiene" {class: juego}

  # Sistemas · engine/
  input: "Input · ADR-0032\nacciones con contextos, cada evento\nal paso de su timestamp" {class: sistema}
  ia: "IA y navegación · ADR-0023\nBT plano, navmesh propia,\nORCA, fichas de ataque" {class: sistema}
  animacion: "Animación · ADR-0015\npor capas, LBS en la GPU,\nIK para el tajo" {class: sistema}
  fisica: "Física · ADR-0016\nSoft Step, cápsulas por hueso,\ntajo barrido en su plano" {class: sistema}
  corte: "Corte de mallas · ADR-0007\ngeométrico en la CPU, hasta donde\nllega la hoja, hendidura en cuña" {class: sistema}
  camara: "Cámara · ADR-0031\ntres estilos que el jugador no mueve,\nfuera de la simulación, cámara del tajo" {class: sistema}
  vfx: "VFX · ADR-0025\nen la CPU en el paso fijo,\nsangre screen-door, decals de malla" {class: sistema}
  ui: "UI · ADR-0026\nimmediate mode a 640×360,\n0 HUD por defecto, subtítulos siempre" {class: sistema}
  render: "Render · ADR-0022\nforward a 640×360, look PSX,\nblit nearest entero, tapa procedural" {class: sistema}
  audio: "Audio · ADR-0024\nmezclador propio en el callback de SDL3,\ncapas del corte por material" {class: sistema}
  recursos: "Recursos y guardado · ADR-0028\nhilo de I/O, slots fijos por zona,\npaquete en el ejecutable, tarjeta de 8 KB" {class: sistema}
  depuracion: "Depuración · ADR-0021\nDear ImGui, Tracy y perf,\nregistro por frame, replay por paso" {class: sistema}

  # GPU · engine/gpu
  vulkan: "Vulkan 1.3 · ADR-0005\nallocator de la GPU propio, sin vk-bootstrap" {class: gpu}

  # Núcleo · engine/core: lo usan todas las piezas, así que no lleva esas flechas
  arquitectura: "Arquitectura · ADR-0012\nECS sparse set, capas estrictas,\npaso fijo de 60 Hz con interpolación" {class: nucleo}
  memoria: "Memoria · ADR-0010\nregiones tocadas al iniciar,\narenas por paso, TLSF para los pedazos" {class: nucleo}
  matematica: "Matemática · ADR-0008\npropia: Y arriba,\ncolumn-major, reverse-Z" {class: nucleo}

  # Plataforma · engine/platform
  sdl: "SDL3 · ADR-0004\ndetrás de una interfaz propia:\nventana, input, tiempo y audio" {class: plataforma}

  # ── Le entrega datos a ──

  # Un frame, del input a la pantalla
  dispositivos -> sdl: "eventos" {class: entrega}
  sdl -> input: "eventos con timestamp" {class: entrega}
  input -> combate: "acciones de cada paso" {class: entrega}
  combate -> animacion: "tajo apuntado" {class: entrega}
  combate -> fisica: "barrido del tajo" {class: entrega}
  combate -> corte: "plano del corte" {class: entrega}
  ia -> fisica: "movimiento de los zombies" {class: entrega}
  ia -> combate: "ataques con ficha" {class: entrega}
  animacion -> fisica: "pose de las cápsulas" {class: entrega}
  animacion -> corte: "pose y pesos" {class: entrega}
  fisica -> combate: "golpes del barrido" {class: entrega}
  fisica -> render: "pedazos y ragdolls movidos" {class: entrega}
  animacion -> render: "paleta de huesos" {class: entrega}
  corte -> fisica: "pedazos" {class: entrega}
  corte -> render: "pedazos y tapa" {class: entrega}
  combate -> vfx: "impactos y cortes" {class: entrega}
  combate -> audio: "sonidos por material" {class: entrega}
  vfx -> render: "partículas" {class: entrega}
  camara -> render: "vista" {class: entrega}
  ui -> render: "pasada de UI" {class: entrega}
  render -> vulkan: "comandos" {class: entrega}
  vulkan -> pantalla: "imagen" {class: entrega}
  audio -> sdl: "mezcla" {class: entrega}
  sdl -> pantalla: "audio" {class: entrega}

  # Mundo, carga y cinemáticas
  cocinador -> recursos: "binarios cocinados" {class: entrega}
  niveles -> recursos: "zonas a cargar" {class: entrega}
  recursos -> vulkan: "subida de zonas" {class: entrega}
  cinematicas -> camara: "tomas" {class: entrega}
  cinematicas -> animacion: "clips de actores" {class: entrega}
  arquitectura -> depuracion: "estado de cada paso" {class: entrega}

  # ── Esta decisión empujó a esa ──

  animacion -> render: "skinning en la GPU:\nsombras blob, sin shadow map" {class: empuja}
  fisica -> render: "las cápsulas dan\nel hueso de la tapa" {class: empuja}
  corte -> memoria: "pedazos de tamaño variable:\nTLSF" {class: empuja}
  arquitectura -> depuracion: "paso fijo:\nreplay por paso" {class: empuja}
  arquitectura -> input: "paso fijo: cada evento\nal paso de su timestamp" {class: empuja}
  sdl -> audio: "el callback de SDL3:\nmezclador propio" {class: empuja}
  camara -> combate: "cámara fuera de la simulación:\napuntado desde el pecho" {class: empuja}
  camara -> ia: "cono de ventaja según\nel rumbo de la caballera" {class: empuja}
  niveles -> recursos: "mundo por zonas:\nslots fijos e hilo de I/O" {class: empuja}
  cocinador -> niveles: "Blender y glTF:\nBlender como editor" {class: empuja}
}

# ── Franja de proceso ────────────────────────────────────────────────────────

proceso: "Proceso: cómo se trabaja y se construye" {
  class: franja
  grid-columns: 2
  # Deja lugar a la etiqueta de la única flecha horizontal (ADR-0033 → ADR-0035).
  horizontal-gap: 170

  # El orden importa: la grilla llena por columnas, y la altura de cada caja decide
  # por dónde pasan las dos flechas que cruzan hacia el mapa sin pisar otras etiquetas.
  # El ADR-0033 va en la segunda columna, al lado del 0035 y entre el 0002 y el 0014,
  # para que sus tres flechas vayan a cajas vecinas.
  adrs: "ADR-0001\ndecisiones en ADRs" {class: proceso}
  ci: "ADR-0029\nCI: contenedor de Arch\ncon fecha fija" {class: proceso}
  cd: "ADR-0035\nCD: Linux y Windows,\nbuilds reproducibles" {class: proceso}
  rendimiento: "ADR-0020\nUHD 620, 60 fps, 640×360" {class: proceso}
  licencias: "ADR-0019\ncódigo MIT,\ndocs y assets CC BY 4.0" {class: proceso}
  lenguaje: "ADR-0003\nC++20" {class: proceso}
  subconjunto: "ADR-0009\nsubconjunto de C++:\nsin excepciones ni RTTI" {class: proceso}
  diagramas: "ADR-0030\ndiagramas técnicos en D2" {class: proceso}
  tickets: "ADR-0002\ntickets en GitHub Issues + Projects" {class: proceso}
  roadmap: "ADR-0033\nun milestone por corte,\ntareas átomo, roadmap vivo" {class: proceso}
  colaboracion: "ADR-0014\ncolaboración: modo dirigido,\ncortes verticales" {class: proceso}
  convenciones: "ADR-0013\nconvenciones y análisis estático" {class: proceso}
  build: "ADR-0006\nCMake + Ninja, Clang/GCC" {class: proceso}
  testing: "ADR-0011\nGoogleTest, TDD en el núcleo,\nxfail por bug" {class: proceso}

  cd -> ci: "reemplaza la CD\ndel ADR-0029" {class: empuja}
  roadmap -> cd: "la CD entra en\nel esqueleto andante" {class: empuja}
  roadmap -> tickets: "épica → tarea,\nsin épicas en el código" {class: empuja}
  roadmap -> colaboracion: "el esqueleto\ntambién lleva tag" {class: empuja}
}

# Decisiones que cruzan de la franja al mapa
proceso.rendimiento -> mapa.render: "640×360 deja el render limitado\npor los vértices: forward sin prepass" {class: empuja}
mapa.ui -> proceso.licencias: "fuentes de píxeles:\nse acepta la OFL" {class: empuja}
